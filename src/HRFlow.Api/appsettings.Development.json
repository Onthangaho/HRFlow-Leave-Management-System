{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=hrflow.db"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "HRFlow.Api",
      "Audience": "HRFlow.Client",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 7
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
