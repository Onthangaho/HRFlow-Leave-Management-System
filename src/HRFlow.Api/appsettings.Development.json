{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=hrflow.db"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "HRFlow.Api",
      "Audience": "HRFlow.Client",
      "SigningKey": "a-very-secure-and-long-signing-key-that-is-at-least-32-bytes-long",
      "RefreshTokenPepper": "a-super-secret-and-unique-pepper-for-refresh-tokens",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 7
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}